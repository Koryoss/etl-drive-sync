# 로컬 테스트용 예시입니다. 실제 값은 .env에 넣고(.gitignore 처리됨),
# GitHub에서는 Settings > Secrets and variables > Actions에 같은 이름으로 등록하세요.
# 이 파일에는 절대 실제 값을 쓰지 마세요.

CANVAS_BASE_URL=https://etl.example.ac.kr
CANVAS_TOKEN=YOUR_TOKEN
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
DRIVE_ROOT_FOLDER_ID=YOUR_FOLDER_ID
